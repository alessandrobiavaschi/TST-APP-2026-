# Copia questo file in .env e inserisci le credenziali del progetto Firebase.
# Firebase Console: https://console.firebase.google.com/

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Su Netlify/hosting: VITE_FIREBASE_* oppure FIREBASE_* oppure (solo build) NEXT_PUBLIC_FIREBASE_*.
# vite.config.js unisce file .env e process.env in __TST_FIREBASE_BUILD__ così il bundle riceve sempre le chiavi al build.
# Opzionale: anche REACT_APP_FIREBASE_* (ex Create React App) viene letto solo in vite.config, non serve envPrefix.
VITE_OPERATOR_ADVANCED_REPORT_KEY=

# Opzionale: URL base (HTTPS) dove sono ospitati 1.mp3 … 72.mp3 — niente cartella audio nel repo/deploy.
# Esempio produzione: https://tst-2026-database.web.app/audio
# Vuoto = stesso sito, path /audio/N.mp3 (metti i file in public/audio per dev).
VITE_AUDIO_BASE_URL=
